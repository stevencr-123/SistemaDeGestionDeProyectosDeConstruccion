    (Gestionar Usuarios)
    (Configurar Sistema)
    (Generar Backups)
}

rectangle "FUNCIONARIO PÚBLICO" {
    (Emitir Licencias)
    (Fiscalizar Obras)
    (Atender Ciudadanos)
}

rectangle "PROMOTOR" {
    (Asignar Tareas)
